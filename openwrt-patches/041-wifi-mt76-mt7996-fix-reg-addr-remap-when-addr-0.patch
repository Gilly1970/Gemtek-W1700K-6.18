From 69f26dbae7e1cd4532747cf0e85b60dcdd61e742 Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Subject: [PATCH] wifi: mt76: mt7996: fix reg addr remap when addr is 0

When addr is less than the hardcoded threshold in __mt7996_reg_addr,
it indicates that remapping is unnecessary. Currently, the flow remaps
address 0x0 to MT_HIF_REMAP_BASE_L2, which is incorrect. Return
INVALID_REG_ADDR for unmapped addresses and check against it, so a
valid low address of 0 is accessed directly instead of thrashing the
L2 remap window under reg_lock.

Backported from openwrt/mt76 master 69f26dba (2026-07-27 nbd series,
landed after our 2c84469c pin); rebased over our 034 (reg_lock
irqsave) — context carries the irqsave lines. Drop at next mt76 bump
past 69f26dba.

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
---
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -17,6 +17,8 @@
 static bool wed_enable;
 module_param(wed_enable, bool, 0644);
 
+#define INVALID_REG_ADDR	0xffffffff
+
 static const struct __base mt7996_reg_base[] = {
 	[WF_AGG_BASE]		= { { 0x820e2000, 0x820f2000, 0x830e2000 } },
 	[WF_ARB_BASE]		= { { 0x820e3000, 0x820f3000, 0x830e3000 } },
@@ -334,7 +336,7 @@
 		return dev->reg.map[i].mapped + ofs;
 	}
 
-	return 0;
+	return INVALID_REG_ADDR;
 }
 
 static u32 __mt7996_reg_remap_addr(struct mt7996_dev *dev, u32 addr)
@@ -367,7 +369,7 @@
 	u32 addr = __mt7996_reg_addr(dev, offset);
 	unsigned long flags;
 
-	if (addr) {
+	if (addr != INVALID_REG_ADDR) {
 		memcpy_fromio(buf, dev->mt76.mmio.regs + addr, len);
 		return;
 	}
@@ -384,7 +386,7 @@
 	u32 addr = __mt7996_reg_addr(dev, offset), val;
 	unsigned long flags;
 
-	if (addr)
+	if (addr != INVALID_REG_ADDR)
 		return dev->bus_ops->rr(mdev, addr);
 
 	spin_lock_irqsave(&dev->reg_lock, flags);
@@ -400,7 +402,7 @@
 	u32 addr = __mt7996_reg_addr(dev, offset);
 	unsigned long flags;
 
-	if (addr) {
+	if (addr != INVALID_REG_ADDR) {
 		dev->bus_ops->wr(mdev, addr, val);
 		return;
 	}
@@ -416,7 +418,7 @@
 	u32 addr = __mt7996_reg_addr(dev, offset);
 	unsigned long flags;
 
-	if (addr)
+	if (addr != INVALID_REG_ADDR)
 		return dev->bus_ops->rmw(mdev, addr, mask, val);
 
 	spin_lock_irqsave(&dev->reg_lock, flags);
