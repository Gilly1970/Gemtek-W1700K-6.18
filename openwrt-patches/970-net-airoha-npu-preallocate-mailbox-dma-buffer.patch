From: Gilly <gilroyscott1970@gmail.com>
Date: Wed, 6 Aug 2026 00:00:00 +1000
Subject: [PATCH] net: airoha: npu: pre-allocate a per-core mailbox DMA buffer

The NPU mailbox buffer is bidirectional: the CPU writes the request and the 
NPU writes its response into the same memory. On non-coherent EN7581 the 
buffer is a caller-side kzalloc() whose size is not a cache-line multiple, 
so its tail shares a line with the adjacent allocation and the DMA_BIDIRECTIONAL 
unmap invalidate corrupts the NPU-written response. WLAN_FUNC_GET_WAIT_NPU_VERSION 
reads back as 0.0 and mt76 never binds NPU offload.

airoha_npu_send_msg() is also a hot path, called per flow bind/unbind under 
spin_lock_bh(&ppe_lock), where a per-message DMA allocation would add an -ENOMEM 
failure mode.

Allocate one coherent buffer per mailbox core at probe (devres-managed), 
reuse it under the existing per-core lock, and reject oversized messages with -EINVAL.
Validated on a Gemtek W1700K (EN7581 + MT7996): NPU firmware version reads 0.1111, 
RX/TX offload work with the CPU idle.

Fixes: 6f884eb87a79 ("net: airoha: Fix DMA direction for NPU mailbox buffer")
Signed-off-by: Gilly <gilroyscott1970@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_npu.c | 33 ++++++++++++-----------
 include/linux/soc/airoha/airoha_offload.h |  2 ++
 2 files changed, 20 insertions(+), 15 deletions(-)

--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -171,6 +171,8 @@ struct airoha_npu {
 		/* protect concurrent npu memory accesses */
 		spinlock_t lock;
 		struct work_struct wdt_work;
+		void *mbox_buf;
+		dma_addr_t mbox_dma;
 	} cores[NPU_NUM_CORES];

 	int irqs[NPU_NUM_IRQ];
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -46,6 +46,8 @@
 #define REG_CR_NPU_MIB(_n)		(NPU_MBOX_BASE_ADDR + 0x140 + ((_n) << 2))

+#define AIROHA_NPU_MBOX_SIZE		PAGE_SIZE
+
 #define NPU_WLAN_BASE_ADDR		0x30d000
@@ -163,15 +165,20 @@ static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 			       void *p, int size)
 {
 	u16 core = 0; /* FIXME */
+	struct airoha_npu_core *c = &npu->cores[core];
 	u32 val, offset = core << 4;
-	dma_addr_t dma_addr;
 	int ret;

-	dma_addr = dma_map_single(npu->dev, p, size, DMA_BIDIRECTIONAL);
-	ret = dma_mapping_error(npu->dev, dma_addr);
-	if (ret)
-		return ret;
+	if (size > AIROHA_NPU_MBOX_SIZE)
+		return -EINVAL;

-	spin_lock_bh(&npu->cores[core].lock);
+	spin_lock_bh(&c->lock);
+
+	memcpy(c->mbox_buf, p, size);

-	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, dma_addr);
+	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, c->mbox_dma);
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, size);
 	regmap_read(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset, &val);
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset, val + 1);
@@ -184,9 +191,10 @@ static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
+	if (!ret)
+		memcpy(p, c->mbox_buf, size);

-	spin_unlock_bh(&npu->cores[core].lock);
-
-	dma_unmap_single(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);
+	spin_unlock_bh(&c->lock);

 	return ret;
 }
@@ -760,6 +768,11 @@ static int airoha_npu_probe(struct platform_device *pdev)
 		spin_lock_init(&core->lock);
 		core->npu = npu;

+		core->mbox_buf = dmam_alloc_coherent(dev, AIROHA_NPU_MBOX_SIZE,
+						     &core->mbox_dma, GFP_KERNEL);
+		if (!core->mbox_buf)
+			return -ENOMEM;
+
 		irq = platform_get_irq(pdev, i + 1);
 		if (irq < 0)
 			return irq;
