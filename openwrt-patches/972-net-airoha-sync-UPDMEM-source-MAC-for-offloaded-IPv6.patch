From: Gilly1970 <gilroyscott1970@gmail.com>
Subject: [PATCH] net: airoha: sync UPDMEM source MAC for offloaded IPv6 flows

IPv6 flow entries reference their source MAC via UPDMEM, which is only updated
by the airoha device's own ndo_set_mac_address — so a VLAN upper with a cloned
MAC egresses offloaded IPv6 with the stale base address (IPv4 carries the MAC 
inline and keeps working), black-holing the flow on MAC-bound ISPs. Fix it by
syncing the UPDMEM slot with the flow's actual source MAC from the flow dissector,
caching the value per port to skip redundant writes. Flows sharing a port with 
different MACs still race for its single slot; a follow-up adds per-MAC allocation.

---
 drivers/net/ethernet/airoha/airoha_eth.h |  3 +++
 drivers/net/ethernet/airoha/airoha_ppe.c | 13 +++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index 9e6e00b..4c67083 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -605,6 +605,9 @@ struct airoha_gdm_port {
 	int id;
 	int users;
 
+	/* base source MAC currently programmed in UPDMEM[id] */
+	u8 smac[ETH_ALEN];
+
 	/* protect concurrent hw_stats and frag register accesses */
 	spinlock_t lock;
 
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index ece613e..6c6cc6e 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -339,6 +339,14 @@ static void airoha_ppe_foe_set_bridge_addrs(struct airoha_foe_bridge *br,
 	br->src_mac_lo = get_unaligned_be32(eh->h_source + 2);
 }
 
+static void airoha_ppe_sync_upd_mem(struct airoha_gdm_dev *dev, const u8 *addr)
+{
+	if (ether_addr_equal(dev->port->smac, addr))
+		return;
+
+	airoha_ppe_init_upd_mem(dev, addr);
+}
+
 static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
@@ -416,6 +424,9 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 						  dsa_port);
 
 			smac_id = port->id;
+			if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
+				airoha_ppe_sync_upd_mem(dev,
+							data->eth.h_source);
 		}
 	}
 
@@ -1545,6 +1556,8 @@ void airoha_ppe_init_upd_mem(struct airoha_gdm_dev *dev, const u8 *addr)
 		     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, port->id) |
 		     FIELD_PREP(PPE_UPDMEM_OFFSET_MASK, 1) |
 		     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+
+	ether_addr_copy(port->smac, addr);
 }
 
 struct airoha_ppe_dev *airoha_ppe_get_dev(struct device *dev)
-- 
2.43.0

