{
	"luci-app-log-viewer": {
		"description": "Grant access to log-viewer procedures",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/sbin/logread*": [ "exec" ],
				"/usr/sbin/logread*": [ "exec" ],
				"/usr/libexec/logread-ubox*": [ "exec" ],
				"/bin/dmesg -r": [ "exec" ]
			},
			"ubus": {
				"system": [ "info" ],
				"luci.log-viewer": [ "getSyslogSize", "getSyslogHash", "getDmesgSize", "getDmesgHash", "getLogfileSize" ]
			}
		}
	}
}
