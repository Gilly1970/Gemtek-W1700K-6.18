CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_w1700k-ubi2=y

CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"

CONFIG_BUSYBOX_CUSTOM=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y

# LuCI

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-ssl=y

# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# 3. Applications

CONFIG_PACKAGE_luci-app-airoha-flowsense=y
CONFIG_PACKAGE_luci-app-log-viewer=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
CONFIG_PACKAGE_luci-app-watchcat=y

# 4. Themes

CONFIG_PACKAGE_luci-theme-bootstrap=y

# Network Support

CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-flower=y

# Network Support

CONFIG_PACKAGE_kmod-br-netfilter=y

# TPROXY

CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# tcpdump — built in-image so it matches the image's libpcap (installing from the
# live snapshot after flash mismatches: snapshot tcpdump wants a remote-capable
# libpcap the older on-box one lacks -> "pcap_open: symbol not found")
CONFIG_PACKAGE_tcpdump=y

# Hardware crypto (EIP93 — DES/3DES/AES + IPsec offload; DT node already in an7581.dtsi)

CONFIG_PACKAGE_kmod-crypto-hw-eip93=y

# SSH

CONFIG_PACKAGE_openssh-sftp-server=y

# Editors

CONFIG_PACKAGE_nano=y

# VPN

CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# arp-scan

CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_fping=y
CONFIG_PACKAGE_iperf3=y

CONFIG_PACKAGE_debugfs=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_wget-ssl=y

# bridger (nbd168 bridge-forwarding accelerator) — L2 offload on top of NPU FOE;
# deps (libbpf/libudebug/libnl-tiny/kmod-sched-*) auto-resolve via defconfig.
# bridger builds eBPF objects → needs an LLVM/clang toolchain. The BPF_TOOLCHAIN
# choice is DEVEL-gated, so DEVEL=y unlocks it; HOST uses the build host's clang.
# HOST_PATH points at a dir of UNVERSIONED llvm symlinks (opt/llc/llvm-dis/strip)
# because Ubuntu ships them only as *-18 and bpf.mk derives an empty version from
# the unversioned `clang`. Create with:
#   mkdir -p .llvm-host/bin && for t in opt llc llvm-dis llvm-strip llvm-objcopy; \
#     do ln -sf "$(command -v $t-18)" .llvm-host/bin/$t; done; \
#     ln -sf /usr/bin/clang .llvm-host/bin/clang
CONFIG_PACKAGE_bridger=y
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/home/gilly/puskill/Gemtek-w1700k-6.18-HW.2.1/.llvm-host"
# tc CLI — needed to inspect bridger's BPF filters / in_hw offload state
# (`tc -s filter show dev <port> ingress`); runtime apk-add doesn't survive sysupgrade
CONFIG_PACKAGE_tc-full=y

CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_rtl826x-firmware=y

CONFIG_PACKAGE_u-boot-an7581_gemtek_w1700k=y